# ─── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/tradevanish

# ─── Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_EXPIRES_IN=7d

# ─── Credential encryption (AES-256-GCM) ───────────────────────────────────
# 32-byte key as 64 hex chars or base64. REQUIRED in production — without it
# the API refuses to boot rather than store broker credentials as plaintext.
# Generate: openssl rand -hex 32
CREDS_KEY=

# ─── Admin ─────────────────────────────────────────────────────────────────
# Guards POST /api/auth/admin/upgrade. Leave unset to disable that route.
ADMIN_SECRET_KEY=

# ─── Stripe ────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_BASIC=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_PROPLUS=price_...

# ─── Email (Resend) ────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=Tradevanish <noreply@tradevanish.com>

# ─── Broker: Tradovate / NinjaTrader OAuth ─────────────────────────────────
TRADOVATE_CLIENT_ID=
TRADOVATE_CLIENT_SECRET=
TRADOVATE_REDIRECT_URI=https://www.tradevanish.com/api/brokers/tradovate/callback
# Set to "true" to force live-endpoint token refresh; defaults to demo.
TRADOVATE_LIVE=false

# ─── Proxy Providers ──────────────────────────────────────────────────────
BRIGHTDATA_ZONE=residential
BRIGHTDATA_USERNAME=
BRIGHTDATA_PASSWORD=
OXYLABS_USERNAME=
OXYLABS_PASSWORD=
SMARTPROXY_USERNAME=
SMARTPROXY_PASSWORD=
IPROYAL_USERNAME=
IPROYAL_PASSWORD=

# ─── Queue (BullMQ / Redis) ────────────────────────────────────────────────
# Optional. Without REDIS_URL the API runs copy execution inline (single-process).
# Set it (and run a worker with SERVICE_ROLE=worker) to scale copy execution out.
REDIS_URL=

# ─── App ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
# Dashboard origin — also used as the CORS allow-origin.
FRONTEND_URL=https://www.tradevanish.com
API_URL=https://www.tradevanish.com/api
# Process role: "api" (default web process) or "worker" (dedicated BullMQ worker).
SERVICE_ROLE=api
