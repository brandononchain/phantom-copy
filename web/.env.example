# ─── API routing ────────────────────────────────────────────────────────────
# Railway: set to the API service's internal URL so Next.js rewrites /api/* to it
# (see next.config.mjs). Example: http://api.railway.internal:3001
# Vercel: leave unset — web/vercel.json handles the /api/* rewrite at the edge.
API_INTERNAL_URL=http://localhost:3001
